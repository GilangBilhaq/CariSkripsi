# Salin menjadi deploy.env (file itu TIDAK boleh dibagikan / di-commit), lalu isi.
# Dipakai oleh scripts/deploy_vps.py.

# Akses SSH ke VPS (login memakai kunci SSH, bukan kata sandi).
VPS_HOST=
VPS_PORT=22
VPS_USER=root

# Alamat situs untuk Caddy:
#   :80                 HTTP biasa (bila HTTPS diurus proxy/domain dari penyedia VPS, atau belum ada domain)
#   cariskripsi.web.id  HTTPS otomatis (butuh domain + port 80 & 443 publik mengarah ke VPS)
SITE_ADDRESS=:80

# 1 bila situs dibuka lewat https:// (cookie login admin hanya dikirim lewat HTTPS). 0 untuk http://.
COOKIE_SECURE=0

# Kunci penanda tangan cookie login admin. Kosongkan: skrip membuatkan yang acak lalu menyimpannya di sini.
CARISKRIPSI_SECRET_KEY=
